{%- comment -%}
  SlabsHub AI — "דלפק הפניות". הצ'אט, מוטמע בדף הבית.

  התקנה:
    1. Snippets > Add a new snippet בשם "slabshub-chat", להדביק את כל הקובץ
    2. ב-sections/comics-index.liquid, בתוך <section class="hero">, להוסיף
       {% render 'slabshub-chat' %} מיד אחרי פסקת ה-<p> של הכותרת הראשית
       ולפני <div class="hero-stage"> — כלומר בין הכותרת לקרוסלה.

  יורש את טוקני העיצוב של הדף (--color-honeycomb-yellow, --radius-card, …) עם
  ערכי גיבוי אם הוא ירונדר מחוץ ל-comics-index.

  טיפוגרפיה: הדף מריץ Times Now / Playfair, שאין להם אותיות עבריות. הסקשן טוען
  Frank Ruhl Libre (הסריף העיתונאי הקלאסי בעברית) ו-Heebo לטקסט הממשק, ומבטל את
  ה-uppercase וריווח האותיות של הדף — שניהם הורסים עברית.

  אין כאן מפתח API. הדפדפן מדבר רק עם ה-Edge Function, שמחזיקה אותו בצד שרת.
{%- endcomment -%}

{%- assign SHC_ENDPOINT = 'https://uvlkacfnbnsqpizktcfi.supabase.co/functions/v1/chat' -%}

<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Heebo:wght@400;500&display=swap" rel="stylesheet">

<div class="shc-section" dir="rtl">
    <div class="section-head">
      <h2>דלפק הפניות</h2>
      <span class="shc-status" id="shc-status">פתוח עכשיו</span>
    </div>

    <div class="shc-panel" id="shc-panel" data-endpoint="{{ SHC_ENDPOINT }}">
      <div class="shc-head">
        <span class="shc-who">SlabsHub AI</span>
        <span class="shc-note">עונה רק על מה שבאמת נמצא בחנות</span>
      </div>

      <div class="shc-log" id="shc-log" role="log" aria-live="polite" aria-label="שיחה עם העוזר של SlabsHub">
        <div class="shc-msg shc-bot">
          <span class="shc-from">הדלפק</span>
          <div class="shc-text">ברוכים הבאים! אני הסוכן קולקטור שלך, תשאל/י אותי כל דבר על החנות, איזה קלף שאתה מחפש, באיזה דירוג אתה מעוניין, או מה מתאים לתקציב שלך.</div>
        </div>
      </div>

      <div class="shc-chips" id="shc-chips">
        <button type="button" class="shc-chip">יש לכם צ'ריזארד?</button>
        <button type="button" class="shc-chip">משהו עד 150 ₪</button>
        <button type="button" class="shc-chip">מה זה PSA 9?</button>
        <button type="button" class="shc-chip">מתנה לילד בן 10</button>
      </div>

      <form class="shc-ask" id="shc-ask">
        <input id="shc-input" type="text" autocomplete="off" maxlength="2000"
               placeholder="תכתוב לדלפק…" aria-label="ההודעה שלך לדלפק">
        <button type="submit" class="shc-send" id="shc-send">שלח</button>
      </form>
    </div>
</div>

<style>
  .shc-section {
    --shc-display: 'Frank Ruhl Libre', 'Times Now', 'Playfair Display', serif;
    --shc-body: 'Frank Ruhl Libre', 'Times New Roman', serif;
    --shc-ui: 'Heebo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --shc-ink: var(--color-carbon-black, #000);
    --shc-yellow: var(--color-honeycomb-yellow, #ffd931);
    max-width: var(--page-max-width, 1200px);
    margin: 0 auto;
    padding-top: 38px;
    text-align: start;
  }
  .shc-section .section-head { align-items: center; }
  .shc-section .section-head h2 { font-family: var(--shc-display); font-weight: 500; }
  .shc-status {
    font-family: var(--shc-ui); font-size: 12px; line-height: 1;
    display: inline-flex; align-items: center; gap: 7px;
  }
  .shc-status::before {
    content: ""; width: 8px; height: 8px; border-radius: 50%;
    background: var(--shc-yellow); border: 1px solid var(--shc-ink);
  }
  .shc-panel {
    border: 2px solid var(--shc-ink);
    border-radius: var(--radius-card, 12px);
    background: #ffffff; overflow: hidden;
  }
  .shc-head {
    background: var(--shc-yellow);
    border-bottom: 2px solid var(--shc-ink);
    padding: 11px 20px;
    display: flex; align-items: baseline; justify-content: space-between; gap: 15px;
  }
  .shc-who {
    font-family: 'Times Now', 'Playfair Display', serif;
    font-weight: 500; font-size: 21px; line-height: 1; direction: ltr;
  }
  .shc-note { font-family: var(--shc-ui); font-size: 12px; line-height: 1.3; text-align: left; }
  .shc-log {
    height: 380px; overflow-y: auto; padding: 22px 20px 6px;
    background:
      linear-gradient(rgba(46, 111, 183, 0.05) 1px, transparent 1px) 0 0 / 100% 22px,
      #ffffff;
  }
  .shc-msg { margin-bottom: 20px; width: fit-content; max-width: min(82%, 52ch); }
  .shc-msg.shc-me { margin-inline-start: auto; }
  .shc-from {
    display: block; font-family: var(--shc-ui); font-size: 12px;
    color: var(--color-ink-black, #231f20); margin-bottom: 5px;
  }
  .shc-me .shc-from { text-align: left; }
  .shc-text {
    font-family: var(--shc-body); font-size: 17px; line-height: 1.6;
    color: var(--shc-ink); white-space: pre-wrap; word-wrap: break-word;
  }
  .shc-bot .shc-text { border-inline-start: 3px solid var(--shc-ink); padding-inline-start: 14px; }
  .shc-me .shc-text {
    background: var(--shc-yellow); border: 1px solid var(--shc-ink);
    border-radius: var(--radius-card, 12px); padding: 9px 14px;
  }
  .shc-text[dir="ltr"] { text-align: left; }
  .shc-text a { border-bottom: 1px dotted var(--shc-ink); word-break: break-all; direction: ltr; }
  .shc-text a:hover { background: var(--shc-yellow); }
  .shc-dots span {
    display: inline-block; width: 6px; height: 6px; margin-inline-end: 4px;
    border-radius: 50%; background: var(--color-fog-gray, #a6a8aa);
    animation: shc-blink 1.1s infinite;
  }
  .shc-dots span:nth-child(2) { animation-delay: 0.18s; }
  .shc-dots span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes shc-blink { 0%, 60%, 100% { opacity: 0.3; } 30% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .shc-dots span { animation: none; opacity: 0.6; } }
  .shc-chips {
    display: flex; flex-wrap: wrap; gap: 8px; padding: 14px 20px;
    border-top: 1px solid var(--color-smoke-line, #d6d6d6);
  }
  .shc-chips.shc-gone { display: none; }
  .shc-chip {
    background: transparent; border: 1px solid var(--shc-ink);
    border-radius: var(--radius-card, 12px); padding: 7px 14px; cursor: pointer;
    font-family: var(--shc-ui); font-size: 13px; line-height: 1;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .shc-chip:hover { background: var(--shc-ink); color: var(--shc-yellow); }
  .shc-ask {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 20px 18px; border-top: 1px solid var(--shc-ink);
  }
  .shc-ask input {
    flex: 1; background: transparent; border: none;
    border-bottom: 1px solid var(--shc-ink);
    font-family: var(--shc-body); font-size: 17px;
    padding: 7px 2px; color: var(--color-ink-black, #231f20); min-width: 0;
  }
  .shc-ask input::placeholder { color: var(--color-fog-gray, #a6a8aa); }
  .shc-send {
    flex: none; background: var(--shc-yellow);
    border: 2px solid var(--shc-ink); border-radius: var(--radius-card, 12px);
    padding: 10px 22px; cursor: pointer;
    font-family: var(--shc-ui); font-size: 13px; line-height: 1;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .shc-send:hover:not(:disabled) { background: var(--shc-ink); color: var(--shc-yellow); }
  .shc-send:disabled { opacity: 0.45; cursor: default; }
  @media (max-width: 560px) {
    .shc-log { height: 320px; padding: 18px 15px 4px; }
    .shc-msg { max-width: 92%; }
    .shc-head { padding: 10px 15px; flex-direction: column; gap: 3px; align-items: flex-start; }
    .shc-note { text-align: right; }
    .shc-chips, .shc-ask { padding-inline: 15px; }
  }
</style>

<script>
(function () {
  var panel = document.getElementById('shc-panel');
  if (!panel) return;
  var ENDPOINT = panel.getAttribute('data-endpoint');
  var log = document.getElementById('shc-log');
  var form = document.getElementById('shc-ask');
  var input = document.getElementById('shc-input');
  var send = document.getElementById('shc-send');
  var chips = document.getElementById('shc-chips');
  var status = document.getElementById('shc-status');
  var busy = false;

  var cid = null;
  try { cid = sessionStorage.getItem('shc-cid'); } catch (e) {}

  // הפאנל עברי כברירת מחדל. מבקר שכותב אנגלית (והתשובה האנגלית שתבוא אחריו)
  // מקבל LTR להודעה הזו בלבד, כדי ששניהם ייקראו נכון.
  function isLatin(t) {
    return !/[֐-׿]/.test(t || '') && /[A-Za-z]/.test(t || '');
  }

  function render(text) {
    var esc = String(text).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
    return esc.replace(/(https?:\/\/[^\s<)]+)/g, function (u) {
      return '<a href="' + u + '">' + u + '</a>';
    });
  }

  function add(who, text) {
    var row = document.createElement('div');
    row.className = 'shc-msg ' + (who === 'me' ? 'shc-me' : 'shc-bot');
    var ltr = isLatin(text);
    row.innerHTML =
      '<span class="shc-from">' + (who === 'me' ? 'אתה' : 'הדלפק') + '</span>' +
      '<div class="shc-text"' + (ltr ? ' dir="ltr"' : '') + '>' + render(text) + '</div>';
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
    return row;
  }

  function thinking() {
    var row = document.createElement('div');
    row.className = 'shc-msg shc-bot';
    row.innerHTML = '<span class="shc-from">הדלפק</span>' +
      '<div class="shc-text shc-dots"><span></span><span></span><span></span></div>';
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
    return row;
  }

  function ask(text) {
    text = (text || '').trim();
    if (!text || busy) return;
    busy = true;
    send.disabled = true;
    if (chips) chips.classList.add('shc-gone');
    add('me', text);
    input.value = '';
    var wait = thinking();

    fetch(ENDPOINT, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ message: text, conversation_id: cid })
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        wait.remove();
        if (d && d.conversation_id) {
          cid = d.conversation_id;
          try { sessionStorage.setItem('shc-cid', cid); } catch (e) {}
        }
        add('bot', (d && d.reply) || 'הדלפק שתק לרגע. תנסה שוב?');
      })
      .catch(function () {
        wait.remove();
        add('bot', 'לא הצלחתי להגיע לדלפק כרגע. תן לזה רגע ותנסה שוב.');
        if (status) status.textContent = 'מתחבר מחדש';
      })
      .then(function () {
        busy = false;
        send.disabled = false;
        input.focus();
      });
  }

  form.addEventListener('submit', function (e) { e.preventDefault(); ask(input.value); });
  if (chips) {
    chips.addEventListener('click', function (e) {
      if (e.target.classList.contains('shc-chip')) ask(e.target.textContent);
    });
  }
})();
</script>
