{%- comment -%}
  SlabsHub AI — "The Enquiry Desk". The chat, embedded in the homepage.

  Install:
    1. Snippets > Add a new snippet named "slabshub-chat", paste this whole file
    2. In sections/comics-index.liquid, add {% render 'slabshub-chat' %}
       on its own line directly after the closing </section> of the hero
       (the one that ends with the hero-dots div), before the "№ 1" section.

  Inherits the page's design tokens (--color-honeycomb-yellow, --font-display,
  …) and falls back to literals if it is ever rendered outside comics-index.
  No API key here — the browser only talks to the Supabase Edge Function, which
  holds the key server-side.
{%- endcomment -%}

{%- assign SHC_ENDPOINT = 'https://uvlkacfnbnsqpizktcfi.supabase.co/functions/v1/chat' -%}

<section class="shc-section">
  <div class="wrap">
    <div class="section-head">
      <h2>The Enquiry Desk</h2>
      <span class="shc-status" id="shc-status">Open now</span>
    </div>

    <div class="shc-panel" id="shc-panel" data-endpoint="{{ SHC_ENDPOINT }}">
      <div class="shc-head">
        <span class="shc-who">SlabsHub AI</span>
        <span class="shc-note">Answers from what is actually in the shop</span>
      </div>

      <div class="shc-log" id="shc-log" role="log" aria-live="polite" aria-label="Conversation with the SlabsHub assistant">
        <div class="shc-msg shc-bot">
          <span class="shc-from">The desk</span>
          <div class="shc-text">Ask me anything about the shop — a card you are hunting, what a grade means, or what fits a budget. I only quote cards we actually have.</div>
        </div>
      </div>

      <div class="shc-chips" id="shc-chips">
        <button type="button" class="shc-chip">Do you have a Charizard?</button>
        <button type="button" class="shc-chip">Something under $40</button>
        <button type="button" class="shc-chip">What does PSA 9 mean?</button>
        <button type="button" class="shc-chip">A gift for a 10-year-old</button>
      </div>

      <form class="shc-ask" id="shc-ask">
        <input id="shc-input" type="text" autocomplete="off" maxlength="2000"
               placeholder="Write to the desk…" aria-label="Your message to the assistant">
        <button type="submit" class="shc-send" id="shc-send">Send</button>
      </form>
    </div>
  </div>
</section>

<style>
  .shc-section .section-head { align-items: center; }
  .shc-status {
    font-family: var(--font-ui, 'Helvetica Neue', Arial, sans-serif);
    font-size: var(--text-caption, 11px);
    letter-spacing: var(--tracking-ui, 0.073em);
    text-transform: uppercase;
    display: inline-flex; align-items: center; gap: 7px;
  }
  .shc-status::before {
    content: ""; width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-honeycomb-yellow, #ffd931);
    border: 1px solid var(--color-carbon-black, #000);
  }
  .shc-panel {
    border: 2px solid var(--color-carbon-black, #000);
    border-radius: var(--radius-card, 12px);
    background: #ffffff;
    overflow: hidden;
  }
  .shc-head {
    background: var(--color-honeycomb-yellow, #ffd931);
    border-bottom: 2px solid var(--color-carbon-black, #000);
    padding: 11px 20px;
    display: flex; align-items: baseline; justify-content: space-between; gap: 15px;
  }
  .shc-who {
    font-family: var(--font-display, 'Times Now', 'Playfair Display', serif);
    font-weight: 500; font-size: 21px; line-height: 1;
  }
  .shc-note {
    font-family: var(--font-ui, 'Helvetica Neue', Arial, sans-serif);
    font-size: var(--text-caption, 11px);
    letter-spacing: var(--tracking-ui, 0.073em);
    text-transform: uppercase;
    text-align: right;
  }
  .shc-log {
    height: 380px; overflow-y: auto;
    padding: 22px 20px 6px;
    background:
      linear-gradient(rgba(46, 111, 183, 0.05) 1px, transparent 1px) 0 0 / 100% 22px,
      #ffffff;
  }
  .shc-msg { margin-bottom: 20px; width: fit-content; max-width: min(82%, 62ch); }
  .shc-msg.shc-me { margin-left: auto; }
  .shc-from {
    display: block;
    font-family: var(--font-ui, 'Helvetica Neue', Arial, sans-serif);
    font-size: var(--text-caption, 11px);
    letter-spacing: var(--tracking-ui, 0.073em);
    text-transform: uppercase;
    color: var(--color-ink-black, #231f20);
    margin-bottom: 5px;
  }
  .shc-me .shc-from { text-align: right; }
  .shc-text {
    font-family: var(--font-body, 'Times New Roman', serif);
    font-size: var(--text-body, 16px);
    line-height: 1.45;
    color: var(--color-carbon-black, #000);
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  .shc-bot .shc-text {
    border-left: 3px solid var(--color-carbon-black, #000);
    padding-left: 14px;
  }
  .shc-me .shc-text {
    background: var(--color-honeycomb-yellow, #ffd931);
    border: 1px solid var(--color-carbon-black, #000);
    border-radius: var(--radius-card, 12px);
    padding: 9px 14px;
  }
  .shc-text[dir="rtl"] { text-align: right; }
  .shc-bot .shc-text[dir="rtl"] {
    border-left: none; padding-left: 0;
    border-right: 3px solid var(--color-carbon-black, #000);
    padding-right: 14px;
  }
  .shc-text a {
    border-bottom: 1px dotted var(--color-carbon-black, #000);
    word-break: break-all;
  }
  .shc-text a:hover { background: var(--color-honeycomb-yellow, #ffd931); }
  .shc-dots span {
    display: inline-block; width: 6px; height: 6px; margin-right: 4px;
    border-radius: 50%; background: var(--color-fog-gray, #a6a8aa);
    animation: shc-blink 1.1s infinite;
  }
  .shc-dots span:nth-child(2) { animation-delay: 0.18s; }
  .shc-dots span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes shc-blink { 0%, 60%, 100% { opacity: 0.3; } 30% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .shc-dots span { animation: none; opacity: 0.6; } }
  .shc-chips {
    display: flex; flex-wrap: wrap; gap: 8px;
    padding: 14px 20px;
    border-top: 1px solid var(--color-smoke-line, #d6d6d6);
  }
  .shc-chips.shc-gone { display: none; }
  .shc-chip {
    background: transparent;
    border: 1px solid var(--color-carbon-black, #000);
    border-radius: var(--radius-card, 12px);
    padding: 7px 13px; cursor: pointer;
    font-family: var(--font-ui, 'Helvetica Neue', Arial, sans-serif);
    font-size: var(--text-caption, 11px);
    letter-spacing: var(--tracking-nav, 0.063em);
    text-transform: uppercase;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .shc-chip:hover { background: var(--color-carbon-black, #000); color: var(--color-honeycomb-yellow, #ffd931); }
  .shc-ask {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 20px 18px;
    border-top: 1px solid var(--color-carbon-black, #000);
  }
  .shc-ask input {
    flex: 1; background: transparent; border: none;
    border-bottom: 1px solid var(--color-carbon-black, #000);
    font-family: var(--font-body, 'Times New Roman', serif);
    font-size: var(--text-body, 16px);
    padding: 7px 2px; color: var(--color-ink-black, #231f20);
    min-width: 0;
  }
  .shc-ask input::placeholder { color: var(--color-fog-gray, #a6a8aa); }
  .shc-send {
    flex: none;
    background: var(--color-honeycomb-yellow, #ffd931);
    border: 2px solid var(--color-carbon-black, #000);
    border-radius: var(--radius-card, 12px);
    padding: 10px 20px; cursor: pointer;
    font-family: var(--font-ui, 'Helvetica Neue', Arial, sans-serif);
    font-size: var(--text-caption, 11px);
    letter-spacing: var(--tracking-ui, 0.073em);
    text-transform: uppercase;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .shc-send:hover:not(:disabled) { background: var(--color-carbon-black, #000); color: var(--color-honeycomb-yellow, #ffd931); }
  .shc-send:disabled { opacity: 0.45; cursor: default; }
  @media (max-width: 560px) {
    .shc-log { height: 320px; padding: 18px 15px 4px; }
    .shc-msg { max-width: 92%; }
    .shc-head { padding: 10px 15px; flex-direction: column; gap: 3px; }
    .shc-note { text-align: left; }
    .shc-chips, .shc-ask { padding-left: 15px; padding-right: 15px; }
  }
</style>

<script>
(function () {
  var panel = document.getElementById('shc-panel');
  if (!panel) return;
  var ENDPOINT = panel.getAttribute('data-endpoint');
  var log = document.getElementById('shc-log');
  var form = document.getElementById('shc-ask');
  var input = document.getElementById('shc-input');
  var send = document.getElementById('shc-send');
  var chips = document.getElementById('shc-chips');
  var status = document.getElementById('shc-status');
  var busy = false;

  var cid = null;
  try { cid = sessionStorage.getItem('shc-cid'); } catch (e) {}

  function isHebrew(t) { return /[֐-׿]/.test(t || ''); }

  function render(text) {
    var esc = String(text).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
    return esc.replace(/(https?:\/\/[^\s<)]+)/g, function (u) {
      return '<a href="' + u + '">' + u + '</a>';
    });
  }

  function add(who, text) {
    var row = document.createElement('div');
    row.className = 'shc-msg ' + (who === 'me' ? 'shc-me' : 'shc-bot');
    var rtl = isHebrew(text);
    row.innerHTML =
      '<span class="shc-from">' + (who === 'me' ? 'You' : 'The desk') + '</span>' +
      '<div class="shc-text"' + (rtl ? ' dir="rtl"' : '') + '>' + render(text) + '</div>';
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
    return row;
  }

  function thinking() {
    var row = document.createElement('div');
    row.className = 'shc-msg shc-bot';
    row.innerHTML = '<span class="shc-from">The desk</span>' +
      '<div class="shc-text shc-dots"><span></span><span></span><span></span></div>';
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
    return row;
  }

  function ask(text) {
    text = (text || '').trim();
    if (!text || busy) return;
    busy = true;
    send.disabled = true;
    if (chips) chips.classList.add('shc-gone');
    add('me', text);
    input.value = '';
    var wait = thinking();

    fetch(ENDPOINT, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ message: text, conversation_id: cid })
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        wait.remove();
        if (d && d.conversation_id) {
          cid = d.conversation_id;
          try { sessionStorage.setItem('shc-cid', cid); } catch (e) {}
        }
        add('bot', (d && d.reply) || 'The desk went quiet for a moment. Try that again?');
      })
      .catch(function () {
        wait.remove();
        add('bot', "I could not reach the desk just now. Give it a moment and try again — or email us and we'll pick it up.");
        if (status) status.textContent = 'Reconnecting';
      })
      .then(function () {
        busy = false;
        send.disabled = false;
        input.focus();
      });
  }

  form.addEventListener('submit', function (e) { e.preventDefault(); ask(input.value); });
  if (chips) {
    chips.addEventListener('click', function (e) {
      if (e.target.classList.contains('shc-chip')) ask(e.target.textContent);
    });
  }
})();
</script>
