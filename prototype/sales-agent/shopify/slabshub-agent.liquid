{%- comment -%}
  SlabsHub AI sales agent widget.

  Install:
    1. Themes > Edit code > Snippets > Add a new snippet, named "slabshub-agent"
    2. Paste this whole file into it
    3. In Layout > theme.liquid, add {% render 'slabshub-agent' %} just before </body>

  No API key lives here. The browser only ever talks to AGENT_ENDPOINT, which is
  a Supabase Edge Function that holds the key server-side.
{%- endcomment -%}

{%- assign AGENT_ENDPOINT = 'https://REPLACE-ME.supabase.co/functions/v1/sales-agent' -%}

<div id="sh-agent" data-endpoint="{{ AGENT_ENDPOINT }}">
  <button class="sh-launcher" type="button" aria-label="דברו עם העוזר של SlabsHub" aria-expanded="false">
    <svg class="sh-device" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
      <rect x="4" y="3" width="56" height="58" rx="9" fill="#a81b1b"/>
      <rect x="4" y="3" width="56" height="54" rx="9" fill="#d92b2b"/>
      <path d="M4 12a9 9 0 0 1 9-9h38a9 9 0 0 1 9 9v6H4z" fill="#ef4a44"/>
      <rect x="7" y="35" width="50" height="2.5" rx="1.2" fill="#a81b1b" opacity=".55"/>
      <circle cx="18" cy="18" r="9.5" fill="#0d3b6f"/>
      <circle cx="18" cy="18" r="7.5" fill="#2f8fe0"/>
      <circle cx="18" cy="18" r="7.5" fill="#67c2f5" class="sh-glow"/>
      <circle cx="15" cy="15" r="2.4" fill="#fff" opacity=".9"/>
      <circle cx="36" cy="13" r="2.6" fill="#c62828"/>
      <circle cx="44" cy="13" r="2.6" fill="#f2c230" class="sh-led-a"/>
      <circle cx="52" cy="13" r="2.6" fill="#5fbf4a" class="sh-led-b"/>
      <path d="M12 51l9 0-9 7z" fill="#FFD84D"/>
      <rect x="34" y="44" width="22" height="9" rx="2.5" fill="#a81b1b" opacity=".5"/>
    </svg>
    <svg class="sh-close" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
      <circle cx="32" cy="32" r="26" fill="#14110c"/>
      <path d="M24 24l16 16M40 24L24 40" stroke="#FFD84D" stroke-width="4" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="sh-panel" role="dialog" aria-label="עוזר SlabsHub" hidden>
    <div class="sh-head">
      <div>
        <div class="sh-t">SlabsHub</div>
        <div class="sh-s">collector assistant</div>
      </div>
      <span class="sh-live"><i></i>online</span>
    </div>
    <div class="sh-stream"></div>
    <div class="sh-chips">
      <button type="button" class="sh-chip">יש לך צ'ריזארד?</button>
      <button type="button" class="sh-chip">משהו עד 100 שקל</button>
      <button type="button" class="sh-chip">מה זה PSA 9?</button>
    </div>
    <form class="sh-composer">
      <input class="sh-input" placeholder="תכתוב משהו..." autocomplete="off" aria-label="הודעה">
      <button class="sh-send" type="submit">שלח</button>
    </form>
    <div class="sh-disclaimer">עוזר AI. תשובות עלולות להיות לא מדויקות — לשאלות על הזמנה או מצב קלף נעביר אותך למתן.</div>
  </div>
</div>

<style>
  #sh-agent { --sh-yellow:#FFD84D; --sh-ink:#14110c; --sh-paper:#fffdf7; --sh-muted:#6b6355; }
  #sh-agent * { box-sizing: border-box; }
  #sh-agent .sh-launcher { position:fixed; bottom:20px; right:20px; width:64px; height:64px; padding:0; border:none; background:none; cursor:pointer; z-index:2147483000; filter:drop-shadow(0 6px 14px rgba(20,17,12,.32)); transition:transform .18s ease; }
  #sh-agent .sh-launcher:hover { transform:translateY(-3px) scale(1.04); }
  #sh-agent .sh-close { display:none; }
  #sh-agent .sh-launcher[aria-expanded="true"] .sh-device { display:none; }
  #sh-agent .sh-launcher[aria-expanded="true"] .sh-close { display:block; }
  #sh-agent .sh-glow { animation: sh-blink 2.6s ease-in-out infinite; }
  @keyframes sh-blink { 0%,88%,100%{opacity:.85} 93%{opacity:.25} }
  #sh-agent .sh-led-a { animation: sh-led 2.6s ease-in-out infinite; }
  #sh-agent .sh-led-b { animation: sh-led 2.6s ease-in-out .35s infinite; }
  @keyframes sh-led { 0%,70%,100%{opacity:.55} 80%{opacity:1} }
  @media (prefers-reduced-motion: reduce) { #sh-agent .sh-glow, #sh-agent .sh-led-a, #sh-agent .sh-led-b { animation:none } }

  #sh-agent .sh-panel { position:fixed; bottom:96px; right:20px; width:376px; max-width:calc(100vw - 24px); height:540px; max-height:calc(100vh - 130px); background:var(--sh-paper); border:2px solid var(--sh-ink); border-radius:6px; display:flex; flex-direction:column; overflow:hidden; z-index:2147483000; box-shadow:0 14px 40px rgba(20,17,12,.26); font-family:inherit; }
  #sh-agent .sh-panel[hidden] { display:none; }
  @media (max-width: 480px) { #sh-agent .sh-panel { right:12px; left:12px; width:auto; bottom:92px; height:calc(100vh - 120px); } }

  #sh-agent .sh-head { background:var(--sh-yellow); border-bottom:2px solid var(--sh-ink); padding:11px 15px; display:flex; align-items:center; gap:10px; color:var(--sh-ink); }
  #sh-agent .sh-t { font-family:Georgia,serif; font-size:17px; line-height:1.1; }
  #sh-agent .sh-s { font-size:9.5px; letter-spacing:1.3px; text-transform:uppercase; color:#6b5a12; margin-top:2px; }
  #sh-agent .sh-live { margin-right:auto; display:flex; align-items:center; gap:5px; font-size:10px; letter-spacing:.8px; text-transform:uppercase; color:#4a7a2a; }
  #sh-agent .sh-live i { width:7px; height:7px; border-radius:50%; background:#58a832; }

  #sh-agent .sh-stream { flex:1; overflow-y:auto; padding:15px; display:flex; flex-direction:column; gap:11px; }
  #sh-agent .sh-row { display:flex; }
  #sh-agent .sh-row.me { justify-content:flex-end; }
  #sh-agent .sh-bubble { max-width:85%; padding:9px 12px; border:1.5px solid var(--sh-ink); border-radius:4px; font-size:14px; line-height:1.6; white-space:pre-wrap; word-wrap:break-word; background:#fff; color:var(--sh-ink); }
  #sh-agent .sh-row.me .sh-bubble { background:var(--sh-yellow); }
  #sh-agent .sh-bubble a { color:#1a4fa0; }
  #sh-agent .sh-rtl { direction:rtl; text-align:right; }

  #sh-agent .sh-chips { padding:0 15px 9px; display:flex; flex-wrap:wrap; gap:6px; }
  #sh-agent .sh-chip { font:inherit; font-size:12px; background:#fff; border:1.5px solid var(--sh-ink); border-radius:20px; padding:5px 11px; cursor:pointer; direction:rtl; color:var(--sh-ink); }
  #sh-agent .sh-chip:hover { background:var(--sh-yellow); }

  #sh-agent .sh-composer { border-top:2px solid var(--sh-ink); padding:9px; display:flex; gap:8px; background:#fff; margin:0; }
  #sh-agent .sh-input { flex:1; font:inherit; font-size:14px; padding:9px 11px; border:1.5px solid var(--sh-ink); border-radius:4px; direction:rtl; min-width:0; color:var(--sh-ink); background:#fff; }
  #sh-agent .sh-send { font:inherit; font-size:13px; padding:9px 15px; background:var(--sh-ink); color:var(--sh-yellow); border:none; border-radius:4px; cursor:pointer; }
  #sh-agent .sh-send:disabled { opacity:.45; cursor:default; }
  #sh-agent .sh-disclaimer { padding:7px 15px 9px; font-size:10.5px; line-height:1.5; color:var(--sh-muted); direction:rtl; background:#fff; border-top:1px solid #ece6d8; }
  #sh-agent .sh-dots span { display:inline-block; width:6px; height:6px; margin-right:3px; background:var(--sh-muted); border-radius:50%; animation:sh-b 1.2s infinite; }
  #sh-agent .sh-dots span:nth-child(2){animation-delay:.2s}
  #sh-agent .sh-dots span:nth-child(3){animation-delay:.4s}
  @keyframes sh-b { 0%,60%,100%{opacity:.25} 30%{opacity:1} }
</style>

<script>
(function () {
  var root = document.getElementById('sh-agent');
  if (!root) return;
  var endpoint = root.dataset.endpoint;
  var launcher = root.querySelector('.sh-launcher');
  var panel = root.querySelector('.sh-panel');
  var stream = root.querySelector('.sh-stream');
  var form = root.querySelector('.sh-composer');
  var input = root.querySelector('.sh-input');
  var sendBtn = root.querySelector('.sh-send');
  var history = [];
  var busy = false;
  var greeted = false;

  function isRtl(t) { return /[֐-׿]/.test(t); }

  function escapeHtml(t) {
    return t.replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }

  function add(who, text) {
    var row = document.createElement('div');
    row.className = 'sh-row ' + (who === 'me' ? 'me' : 'bot');
    var b = document.createElement('div');
    b.className = 'sh-bubble' + (isRtl(text) ? ' sh-rtl' : '');
    b.innerHTML = escapeHtml(text).replace(/(https?:\/\/[^\s<)]+)/g,
      '<a href="$1" target="_blank" rel="noopener nofollow">$1</a>');
    row.appendChild(b);
    stream.appendChild(row);
    stream.scrollTop = stream.scrollHeight;
    return row;
  }

  function thinking() {
    var row = document.createElement('div');
    row.className = 'sh-row bot';
    row.innerHTML = '<div class="sh-bubble"><span class="sh-dots"><span></span><span></span><span></span></span></div>';
    stream.appendChild(row);
    stream.scrollTop = stream.scrollHeight;
    return row;
  }

  function send(text) {
    if (busy || !text.trim()) return;
    busy = true;
    sendBtn.disabled = true;
    add('me', text);
    history.push({ role: 'user', content: text });
    var wait = thinking();
    fetch(endpoint, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ messages: history, page: location.pathname })
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        wait.remove();
        if (data.messages) history = data.messages;
        add('bot', data.reply || 'משהו השתבש. תנסה שוב?');
      })
      .catch(function () {
        wait.remove();
        add('bot', 'לא הצלחתי להתחבר כרגע. אפשר לכתוב למתן ב-Slabshub@gmail.com');
      })
      .then(function () {
        busy = false;
        sendBtn.disabled = false;
        input.focus();
      });
  }

  launcher.addEventListener('click', function () {
    var open = panel.hasAttribute('hidden');
    if (open) { panel.removeAttribute('hidden'); } else { panel.setAttribute('hidden', ''); }
    launcher.setAttribute('aria-expanded', String(open));
    if (open) {
      if (!greeted) {
        greeted = true;
        add('bot', 'היי! אני העוזר של SlabsHub — סוכן AI, לא בן אדם.\nמחפש קלף מסוים, או שנתחיל מהתקציב?');
      }
      input.focus();
    }
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var v = input.value;
    input.value = '';
    send(v);
  });

  root.querySelector('.sh-chips').addEventListener('click', function (e) {
    if (e.target.classList.contains('sh-chip')) send(e.target.textContent);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.hasAttribute('hidden')) launcher.click();
  });
})();
</script>
