  "name": "Chat landing page",
  "settings": [
    {
      "type": "select",
      "id": "lang",
      "label": "Language",
      "options": [
        { "value": "he", "label": "Hebrew" },
        { "value": "en", "label": "English" }
      ],
      "default": "he"
    }
  ]
