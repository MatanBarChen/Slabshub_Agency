# Secrets — never commit
.env
.env.*
env*.txt

# OS / editor noise
Thumbs.db
.DS_Store

# Python cache
__pycache__/
*.pyc

# Node
node_modules/

# Prototype chat logs (may contain visitor contact details)
prototype/sales-agent/conversations/

# Generated by catalog_to_sql.py / prompt_to_sql.py — derived from the sources
# next to them, regenerate rather than commit
prototype/sales-agent/catalog.sql
prototype/sales-agent/prompt.sql

# Generated chat previews (rebuild with build_preview.py)
prototype/sales-agent/shopify/**/preview*.html
