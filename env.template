# SlabsHub Agency — .env template
#
# HOW TO USE
#   1. Copy this file to `.env` in the workspace root (same folder as CLAUDE.md).
#   2. Fill in the values after each `=`.
#   3. Save. `.env` is gitignored and never leaves your machine.
#
# FORMAT RULES — the scripts parse this file with a simple `line.startswith("KEY=")`,
# so the format is strict:
#   ✅  GEMINI_API_KEY=AIza123abc
#   ❌  GEMINI_API_KEY = AIza123abc      (no spaces around =)
#   ❌  GEMINI_API_KEY="AIza123abc"      (no quotes)
#   ❌  export GEMINI_API_KEY=AIza123abc (no export)
#
# This file must be copied to each machine by hand (Windows desktop + MacBook).
# It is NOT synced by git — that is deliberate.


# ─────────────────────────────────────────────────────────────
# META GRAPH API — Facebook Page + Instagram publishing
# ─────────────────────────────────────────────────────────────
# Where to get these: developers.facebook.com → Graph API Explorer
#
# META_PAGE_TOKEN  Page access token that NEVER expires.
#                  Recipe: Get User Access Token (with the 6 scopes below)
#                  → Access Token Debugger → Extend Access Token
#                  → back in Explorer, run `me/accounts` with that long-lived
#                    user token → the page token in the response never expires.
#                  Verify in the Debugger: Expires = Never, Type = Page.
#                  Required scopes: pages_show_list, pages_manage_posts,
#                  pages_read_engagement, instagram_basic,
#                  instagram_content_publish, read_insights
#
# META_PAGE_ID     The `id` field from the same `me/accounts` response.
#
# META_IG_USER_ID  Run in Explorer: {page-id}?fields=instagram_business_account
#                  Empty result = the Instagram account is not properly linked.
#                  Fix: Instagram → Settings → Account type → Professional,
#                  then link to the Facebook Page in Meta Business Suite.

META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=


# ─────────────────────────────────────────────────────────────
# ALREADY CONNECTED — keep your existing values
# ─────────────────────────────────────────────────────────────
# If you already have a working .env, do NOT overwrite these with blanks.
# Copy your current values across instead.

# Gemini — image generation (gemini-3.1-flash-image / Imagen 4) and video (Veo 3.1)
# Source: aistudio.google.com → API keys
GEMINI_API_KEY=

# Tavily — market research and web extraction (used by scout, product-intelligence)
